FROM python:3.12-slim

WORKDIR /app

# Pins match uv.lock. Do not let mcp float to 2.x: it drops
# `from mcp.server import FastMCP`, which servers/search_server.py needs.
RUN pip install --no-cache-dir uv && \
    uv pip install --system --no-cache-dir \
    mcp==1.28.0 beautifulsoup4==4.15.0 requests==2.34.2

COPY servers/search_server.py .

CMD ["python", "search_server.py"]